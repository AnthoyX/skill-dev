{
  "type": "page",
  "title": "V-10 按钮级 reload",
  "body": [
    {
      "type": "alert",
      "level": "info",
      "body": "<div style='font-size:14px;line-height:1.9'>页面加载有第一条 GET /api/mock2/sample。A1/A2/B/C 四组，每组之间刷新页面重置计数。</div>",
      "className": "mb-3"
    },
    {
      "type": "crud",
      "id": "mainCrud",
      "name": "mainCrud",
      "syncLocation": false,
      "perPageAvailable": [10, 20],
      "api": "/api/mock2/sample",
      "columns": [
        { "name": "id", "label": "ID" },
        { "name": "engine", "label": "Engine" },
        { "name": "browser", "label": "Browser" }
      ]
    },
    { "type": "divider" },
    {
      "type": "button",
      "label": "A1 组：弹层内 ajax 按钮 顶层reload + close:true",
      "level": "primary",
      "className": "mb-2",
      "actionType": "dialog",
      "dialog": {
        "title": "A1 组 - 带 close",
        "size": "lg",
        "actions": [],
        "body": {
          "type": "crud",
          "loadDataOnce": true,
          "selectable": true,
          "api": "/api/mock2/sample",
          "columns": [
            { "name": "id", "label": "ID" },
            { "name": "engine", "label": "Engine" }
          ],
          "bulkActions": [
            {
              "type": "button",
              "label": "提交并刷新外层（顶层 reload + close:true）",
              "level": "primary",
              "actionType": "ajax",
              "api": { "method": "post", "url": "/api/mock2/form/saveForm?waitSeconds=2" },
              "close": true,
              "reload": "mainCrud"
            }
          ]
        }
      }
    },
    {
      "type": "button",
      "label": "A2 组：弹层内 ajax 按钮 顶层reload（不带 close）",
      "level": "info",
      "className": "mb-2 ml-2",
      "actionType": "dialog",
      "dialog": {
        "title": "A2 组 - 不带 close",
        "size": "lg",
        "actions": [],
        "body": {
          "type": "crud",
          "loadDataOnce": true,
          "selectable": true,
          "api": "/api/mock2/sample",
          "columns": [
            { "name": "id", "label": "ID" },
            { "name": "engine", "label": "Engine" }
          ],
          "bulkActions": [
            {
              "type": "button",
              "label": "提交并刷新外层（顶层 reload，不带 close）",
              "level": "primary",
              "actionType": "ajax",
              "api": { "method": "post", "url": "/api/mock2/form/saveForm?waitSeconds=2" },
              "reload": "mainCrud"
            }
          ]
        }
      }
    },
    {
      "type": "button",
      "label": "B 组：actionType:reload + target",
      "level": "success",
      "className": "mb-2 ml-2",
      "actionType": "reload",
      "target": "mainCrud"
    },
    {
      "type": "button",
      "label": "C 组：actionType:reload + 顶层 reload 属性（不用 target）",
      "level": "warning",
      "className": "mb-2 ml-2",
      "actionType": "reload",
      "reload": "mainCrud"
    }
  ]
}
