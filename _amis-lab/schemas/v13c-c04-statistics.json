      ],
      "footerToolbar": ["statistics", "pagination"]
    },
    { "type": "tpl", "tpl": "C group: total=5 with tpl instead of statistics (C-04 workaround)" },
    {
      "type": "crud",
      "id": "crudC",
      "name": "crudC",
