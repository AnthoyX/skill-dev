          },
          "source": {
            "method": "get",
            "url": "/api/lab/f04bsrc?term=${term}&wrap=array",
            "sendOn": "${term.length >= 3}"
          }
        },
        {
          "type": "select",
          "name": "selC",
          "label": "C-no-sendOn",
          "placeholder": "C",
          "autoComplete": {
            "method": "get",
            "url": "/api/lab/f04c?term=${term}&wrap=array"
          }
        }
      ]
    }
  ]
