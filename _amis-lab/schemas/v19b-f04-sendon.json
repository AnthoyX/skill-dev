{
  "type": "page",
  "title": "V-19 F-04 sendOn",
  "body": [
    {
      "type": "form",
      "title": "F-04: A=sendOn在autoComplete内  B=sendOn在source内  C=无sendOn(基线)",
      "body": [
        {
          "type": "select",
          "name": "selA",
          "label": "A-sendOn-in-autoComplete",
