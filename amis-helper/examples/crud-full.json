{
  "type": "page",
  "title": "XXX Management",
  "body": [
    {
      "type": "service",
      "id": "pageStateService",
      "data": {
        "exportDownloading": false,
        "formLoading": false
      },
      "body": [
        {
          "type": "alert",
          "body": "Page usage hint here.",
          "level": "info",
          "className": "mb-2"
        },
        {
          "type": "crud",
          "id": "mainCrud",
          "name": "mainCrud",
          "syncLocation": false,
          "defaultParams": { "perPage": 50, "page": 1 },
          "perPageAvailable": [20, 50, 100, 150],
          "api": {
            "method": "post",
            "url": "/XXX/XXXX/page",
            "data": {
              "code": "${code}",
              "name": "${name}",
              "current": "${page}",
              "size": "${perPage}"
            },
            "adapter": "return { ...payload, data: { items: payload.data.rows, total: payload.data.total } };"
          },
          "filter": {
            "title": "Filter",
            "actions": [
              { "type": "reset", "label": "Reset" },
              { "type": "submit", "label": "Search", "level": "primary" }
            ],
            "body": [
              {
                "type": "select",
                "name": "code",
                "label": "Item",
                "placeholder": "Search by code or name",
                "clearable": true,
                "columnRatio": 2,
                "overlayStyle": { "width": "450px" },
                "autoComplete": {
                  "method": "get",
                  "url": "/XXX/XXXX/search?keyword=${term}",
                  "sendOn": "${term != null && term.length >= 3}"
                }
              },
              {
                "type": "select",
                "name": "country",
                "label": "Country",
                "clearable": true,
                "multiple": true,
                "searchable": true,
                "extractValue": true,
                "joinValues": true,
                "delimiter": ",",
                "labelField": "name",
                "valueField": "name",
                "source": {
                  "method": "get",
                  "url": "/XXX/XXXX/dict/list?type=Country",
                  "adaptor": "return { status: payload.code === 200 ? 0 : payload.code, data: payload.data };"
                }
              }
            ]
          },
          "headerToolbar": [
            "reload",
            "filter-toggler",
            {
              "type": "button",
              "label": "Import",
              "level": "primary",
              "icon": "fa fa-upload",
              "actionType": "dialog",
              "dialog": {
                "title": "Import",
                "actions": [
                  { "type": "button", "label": "Cancel", "actionType": "close" },
                  {
                    "type": "button",
                    "label": "Confirm Import",
                    "level": "primary",
                    "actionType": "submit",
                    "close": false,
                    "loadingOn": "${formLoading}"
                  }
                ],
                "body": {
                  "type": "form",
                  "onEvent": {
                    "submitSucc": {
                      "actions": [
                        { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "formLoading": false } } },
                        { "actionType": "reload", "componentId": "mainCrud" },
                        { "actionType": "closeDialog" }
                      ]
                    },
                    "submitFail": {
                      "actions": [
                        { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "formLoading": false } } }
                      ]
                    }
                  },
                  "api": {
                    "method": "post",
                    "url": "/XXX/XXXX/import",
                    "dataType": "form-data",
                    "reload": "mainCrud"
                  },
                  "body": [
                    { "type": "alert", "body": "Import rules here.", "level": "warning" },
                    {
                      "type": "input-file",
                      "name": "file",
                      "label": "Excel File",
                      "accept": ".xlsx,.xls",
                      "asBlob": true,
                      "required": true,
                      "hint": "Template columns: code / type / remark",
                      "btnText": "Select File",
                      "reUploadBtnText": "Re-upload"
                    },
                    {
                      "type": "button",
                      "label": "Download Template",
                      "level": "link",
                      "icon": "fa fa-download",
                      "onEvent": {
                        "click": {
                          "actions": [
                            {
                              "actionType": "download",
                              "args": {
                                "api": { "method": "get", "url": "/XXX/XXXX/downloadTemplate" }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "Add",
              "level": "success",
              "icon": "fa fa-plus",
              "actionType": "dialog",
              "dialog": {
                "title": "Add Record",
                "actions": [
                  { "type": "button", "label": "Cancel", "actionType": "close" },
                  {
                    "type": "button",
                    "label": "Submit",
                    "level": "primary",
                    "actionType": "submit",
                    "close": false,
                    "loadingOn": "${formLoading}"
                  }
                ],
                "body": {
                  "type": "form",
                  "onEvent": {
                    "submitSucc": {
                      "actions": [
                        { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "formLoading": false } } },
                        { "actionType": "reload", "componentId": "mainCrud" },
                        { "actionType": "closeDialog" }
                      ]
                    },
                    "submitFail": {
                      "actions": [
                        { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "formLoading": false } } }
                      ]
                    }
                  },
                  "api": {
                    "method": "post",
                    "url": "/XXX/XXXX/add",
                    "reload": "mainCrud"
                  },
                  "body": [
                    {
                      "type": "select",
                      "name": "code",
                      "label": "Item",
                      "clearable": true,
                      "required": true,
                      "validations": { "isRequired": true },
                      "overlayStyle": { "width": "450px" },
                      "autoComplete": {
                        "method": "get",
                        "url": "/XXX/XXXX/search?keyword=${term}",
                        "sendOn": "${term != null && term.length >= 3}"
                      }
                    },
                    {
                      "type": "textarea",
                      "name": "remark",
                      "label": "Remark",
                      "maxLength": 200
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "Export",
              "level": "warning",
              "icon": "fa fa-download",
              "loadingOn": "${exportDownloading}",
              "onEvent": {
                "click": {
                  "actions": [
                    { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "exportDownloading": true } } },
                    {
                      "actionType": "download",
                      "args": {
                        "api": {
                          "method": "get",
                          "url": "/XXX/XXXX/export",
                          "data": {
                            "code": "${code}",
                            "country": "${country}"
                          }
                        }
                      }
                    },
                    { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "exportDownloading": false } } }
                  ]
                }
              }
            }
          ],
          "columns": [
            { "name": "id", "label": "ID", "width": 80, "hidden": true },
            { "name": "code", "label": "Code", "width": 130, "copyable": true },
            { "name": "name", "label": "Name" },
            {
              "name": "status",
              "label": "Status",
              "type": "mapping",
              "map": {
                "Enabled": "<span class='label label-success'>Enabled</span>",
                "Disabled": "<span class='label label-danger'>Disabled</span>",
                "*": "<span class='label label-default'>(blank)</span>"
              }
            },
            { "name": "remark", "label": "Remark", "width": 150 },
            { "name": "createdTime", "label": "Created Time", "type": "datetime", "width": 170 },
            {
              "type": "operation",
              "label": "Action",
              "fixed": "right",
              "width": 220,
              "buttons": [
                {
                  "type": "button",
                  "label": "Edit Remark",
                  "level": "info",
                  "icon": "fa fa-edit",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "Edit - ${code}",
                    "actions": [
                      { "type": "button", "label": "Cancel", "actionType": "close" },
                      {
                        "type": "button",
                        "label": "Save",
                        "level": "primary",
                        "actionType": "submit",
                        "close": false,
                        "loadingOn": "${formLoading}"
                      }
                    ],
                    "body": {
                      "type": "form",
                      "onEvent": {
                        "submitSucc": {
                          "actions": [
                            { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "formLoading": false } } },
                            { "actionType": "reload", "componentId": "mainCrud" },
                            { "actionType": "closeDialog" }
                          ]
                        },
                        "submitFail": {
                          "actions": [
                            { "actionType": "setValue", "componentId": "pageStateService", "args": { "value": { "formLoading": false } } }
                          ]
                        }
                      },
                      "api": {
                        "method": "post",
                        "url": "/XXX/XXXX/edit",
                        "reload": "mainCrud"
                      },
                      "body": [
                        { "type": "static", "name": "code", "label": "Code", "value": "${code}" },
                        { "type": "static", "name": "name", "label": "Name" },
                        { "type": "textarea", "name": "remark", "label": "Remark", "maxLength": 200 },
                        { "type": "hidden", "name": "id" }
                      ]
                    }
                  }
                }
              ]
            }
          ],
          "footerToolbar": [
            "switch-per-page",
            { "type": "tpl", "tpl": "Total ${total} records, Page ${page}" },
            "pagination"
          ]
        }
      ]
    }
  ]
}
